# SERVER/LOCAL DEVELOPMENT TEMPLATE — replace placeholders privately.
# Copy exact connection strings from Supabase Connect; never guess the pooler host.
# Session pooling supports IPv4 migration sessions. A reachable direct URL is also valid.
# Percent-encode reserved characters in the database password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@[POOLER-HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@[POOLER-HOST]:5432/postgres"
DATABASE_CONNECTION_LIMIT="5"

# Public Auth configuration used by web and API. Keep GitHub OAuth client secrets in Supabase.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:4000"

# API listener and exact frontend origins.
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000"

# GitHub repository App (separate from Supabase GitHub OAuth login).
# Configure either the private key text or a private key file path.
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY_PATH=""
GITHUB_WEBHOOK_SECRET=""

# Base64-encoded 32-byte AES-GCM key. Preserve it for existing encrypted secrets.
ENVIRONMENT_SECRET_KEY=""

# Optional private object storage.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="deploypilot-artifacts"

# Optional deployment notifications: configure a verified sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional AI: both features share limited quotas. No paid provider fallback.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
AI_CHAT_ENABLED="false"
AI_DIAGNOSIS_ENABLED="false"

# Optional restricted operator configuration. Keep this off team workers.
OPERATIONS_ALERT_TOKEN=""
OPERATIONS_ALERT_EMAIL=""
OPERATIONS_WORKER_ID=""

# Workers belong in a SEPARATE checkout/config using .env.worker.example.
# Redis/BullMQ is legacy integration code and is not required for deployment polling.
