# WORKER-ONLY TEMPLATE. Register this repository's worker in the dashboard first.
# Copy to a private worker.env for the installer, or .env in a separate worker checkout.
# Never copy the API/server .env to a team-owned worker.
WORKER_API_URL="https://deploypilot-i4fj.onrender.com"
WORKER_ID="replace-with-registered-worker-id"
WORKER_TOKEN="replace-with-one-time-worker-token"
# The installed release reports its own version; do not pin a stale WORKER_VERSION.
# Set none to disable network access for Dockerfile RUN instructions.
WORKER_BUILD_NETWORK="bridge"
