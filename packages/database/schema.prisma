generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DeploymentStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum DeploymentTrigger {
  MANUAL
  PUSH
  RETRY
}

enum StageStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id          String   @id @default(uuid())
  supabaseId  String   @unique
  email       String   @unique
  displayName String?
  emailNotifications String @default("ALL")
  createdAt   DateTime @default(now())
  repositories Repository[]
  installations GitHubInstallation[]
  memberships TeamMember[]
}

model GitHubInstallation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String   @unique
  accountLogin   String
  createdAt      DateTime @default(now())
  repositories   Repository[]
  @@index([userId])
}

model Repository {
  id              String   @id @default(uuid())
  ownerId         String
  teamId          String?
  team            Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  installationId  String?
  installation    GitHubInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  githubRepoId    String   @unique
  fullName        String
  defaultBranch   String
  createdAt       DateTime @default(now())
  environments    Environment[]
  configs         DeploymentConfig[]
  deployments     Deployment[]
  workers         Worker[]
  @@index([ownerId])
  @@index([teamId])
}

model Environment {
  id           String   @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  url          String?
  policy       Json
  secrets      EnvironmentSecret[]
  deployments  Deployment[]
  @@unique([repositoryId, name])
}

model DeploymentConfig {
  id           String   @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  branchRule   String
  profile      Json
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  deployments  Deployment[]
}

model Deployment {
  id             String   @id @default(uuid())
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  configId       String
  config         DeploymentConfig @relation(fields: [configId], references: [id])
  sourceBranch   String?
  requestedById  String?
  approvalStatus String @default("NOT_REQUIRED")
  approvedById   String?
  approvedAt     DateTime?
  commitSha      String
  trigger        DeploymentTrigger
  status         DeploymentStatus @default(QUEUED)
  targetWorkerId String?
  environmentId  String?
  environment    Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  stages         DeploymentStage[]
  logs           DeploymentLog[]
  events         DeploymentEvent[]
  diagnosis     AIDiagnosis?
  effects       DeploymentEffect[]
  @@index([repositoryId, createdAt])
  @@index([targetWorkerId, status, createdAt], map: "Deployment_worker_queue_idx")
}

model DeploymentStage {
  id           String @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  name         String
  status       StageStatus @default(PENDING)
  startedAt    DateTime?
  endedAt      DateTime?
  @@unique([deploymentId, name])
}

model DeploymentLog {
  id           String @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  sequence     Int
  stage        String
  level        String
  message      String
  createdAt    DateTime @default(now())
  @@unique([deploymentId, sequence])
  @@index([deploymentId, sequence])
}

model DeploymentEvent {
  id           String @id @default(uuid())
  sequence     Int @unique @default(autoincrement())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type         String
  payload      Json
  createdAt    DateTime @default(now())
  @@index([deploymentId, createdAt])
}

model EnvironmentSecret {
  id            String @id @default(uuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name          String
  ciphertext    String
  keyVersion    Int
  @@unique([environmentId, name])
}

model Worker {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  tokenHash    String   @unique
  tokenExpiresAt DateTime?
  credentialOwnerId String?
  version      String
  capabilities Json
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
}

model WebhookDelivery {
  deliveryId String @id
  event      String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  outcome    String?
}

model AIDiagnosis {
  id           String @id @default(uuid())
  deploymentId String @unique
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  model        String
  inputHash    String
  response     Json
  createdAt    DateTime @default(now())
}

model DeploymentEffect {
  id           String @id @default(uuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  kind         String
  status       String @default("PENDING")
  attempts     Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt     DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  @@unique([deploymentId, kind])
  @@index([status, nextAttemptAt])
}

enum TeamRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Team {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  members TeamMember[]
  invites TeamInvite[]
  repositories Repository[]
  audit TeamAudit[]
}

model TeamMember {
  teamId String
  userId String
  role TeamRole
  joinedAt DateTime @default(now())
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id String @id @default(uuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email String
  role TeamRole
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([teamId, createdAt])
}

model TeamAudit {
  id String @id @default(uuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorId String
  action String
  subject String
  createdAt DateTime @default(now())
  @@index([teamId, createdAt])
}
